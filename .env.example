# Contoh variabel lingkungan — JANGAN pernah mengisi berkas ini dengan nilai asli.
# Aplikasi tidak butuh kredensial saat berjalan; kredensial hanya dipakai untuk deploy.
#
# Simpan nilainya sebagai GitHub Secrets:
#   Settings -> Secrets and variables -> Actions -> New repository secret

# Token API Cloudflare dengan izin "Workers Scripts: Edit"
CLOUDFLARE_API_TOKEN=

# ID akun Cloudflare (Dashboard -> Workers & Pages -> Account ID)
CLOUDFLARE_ACCOUNT_ID=

# Port server pengembangan lokal (opsional, bawaan 4173)
PORT=4173
